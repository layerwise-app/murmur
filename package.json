{
  "name": "murmur",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "release": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-local.mjs",
    "voices": "node --no-warnings scripts/generate-voices.ts",
    "add-images": "node scripts/add-images.mjs",
    "brand": "node --no-warnings scripts/render-brand.mjs",
    "art": "node --no-warnings scripts/render-art.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@layerwise/vite": "^0.1.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "^1.91.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.1.0",
    "wrangler": "4.137.0"
  }
}
